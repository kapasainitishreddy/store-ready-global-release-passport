{
  "name": "releaseproof-global-release-passport",
  "version": "1.0.0",
  "private": false,
  "description": "Local-first multi-app release workspace with per-market planning and evidence-linked static checks",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node apps/releaseproof/server.mjs",
    "test": "node --test apps/releaseproof/test/*.test.mjs",
    "benchmark": "node apps/releaseproof/benchmark.mjs",
    "build:demo-reports": "node apps/releaseproof/generate-demo-reports.mjs",
    "build:market-catalog": "node apps/releaseproof/generate-market-catalog.mjs",
    "build:browser-engine": "node apps/releaseproof/build-browser-engine.mjs"
  }
}
